[Desktop Entry]
# Installed by setup.py to ~/.local/share/applications/, which fills in the
# path of deploy.py below (a desktop entry cannot expand ~).
# MimeType=inode/directory puts it into the file manager's "Open With" menu,
# for every folder: a desktop entry cannot ask whether deploy.py is there, so
# the command says so when it is not.
Type=Application
Name=Deploy
Comment=Run this project's deploy.py on the host, after offering to apply open proposals
Exec=@DEPLOY@ --pause %f
Icon=utilities-terminal
Terminal=true
MimeType=inode/directory;
Categories=Development;
Keywords=devcontainer;sandbox;deploy;
StartupNotify=true
