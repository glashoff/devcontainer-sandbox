[Desktop Entry]
# Installed by setup.py to ~/.local/share/applications/, which fills in the
# path of push.py below (a desktop entry cannot expand ~).
# MimeType=inode/directory puts it into the file manager's "Open With" menu.
Type=Application
Name=Git push
Comment=Show what this project would push, then push it from the host
Exec=@PUSH@ --pause %f
Icon=utilities-terminal
Terminal=true
MimeType=inode/directory;
Categories=Development;
Keywords=devcontainer;sandbox;git;push;
StartupNotify=true
