# Sandbox settings for this project, read by devcontainer-start on the host.
# Parsed, never executed. Read-only from inside the container.

# SSH access to a server with a certificate that is renewed on every start and
# valid for 24 hours (README "Server access"). Leave SERVER_SSH_HOST empty for
# no server access.
#
# SERVER_SSH_USER is this project's own user on the server, so that a
# compromised container reaches only this project's files. The server decides
# which users it accepts (setup-ca.py on the host); asking for one it does not
# allow simply fails.
SERVER_SSH_HOST=
SERVER_SSH_USER=
SERVER_SSH_PORT=22
# Name to use inside the container: ssh server
SERVER_SSH_ALIAS=server
