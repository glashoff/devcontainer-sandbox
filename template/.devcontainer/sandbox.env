# Sandbox settings for this project, read by devcontainer-start on the host.
# Parsed, never executed. Read-only from inside the container.

# SSH access to a server with a certificate that is renewed on every start and
# valid for 24 hours (README "Server access"). Leave SERVER_SSH_HOST empty for
# no server access.
#
# SERVER_SSH_USER is this project's own user on the server, so that a
# compromised container reaches only this project's files. The server decides
# which users it accepts (setup-ca.py on the host); asking for one it does not
# allow simply fails.
SERVER_SSH_HOST=
SERVER_SSH_USER=
SERVER_SSH_PORT=22
# Name to use inside the container: ssh server
SERVER_SSH_ALIAS=server
# One command the certificate forces, instead of a shell. For a project that
# has exactly one job on the server, e.g. uploading to one directory. Then
# "ssh server" is no longer interactive and runs this command, whatever it is
# asked for. This can only narrow what the server already grants this user.
#SERVER_SSH_FORCE_COMMAND=/usr/bin/rrsync -wo /srv/www/example.com

# Git identity for commits made inside this project's container. Without
# these, the host's setting is used (~/.config/devcontainer-sandbox/config,
# else the host's git identity). There are no credentials either way.
#GIT_USER_NAME=
#GIT_USER_EMAIL=

# The repository this project belongs to, whatever .git/config says (the
# container can change that file). If it is on GitHub, devcontainer-start
# registers a read-only deploy key for it, so the container can fetch it,
# private repositories too (README "Fetching from GitHub"). GIT_DEPLOY_KEY=no
# turns the key off; the container then fetches public repositories over HTTPS
# only.
GIT_REMOTE_URL=
#GIT_DEPLOY_KEY=no
